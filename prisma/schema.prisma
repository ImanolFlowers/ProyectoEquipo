generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}


enum Role {
  ARBITRO
  ENTRENADOR
  VISITANTE
}

enum EstadoTemporada {
  ACTIVA
  FINALIZADA
}

enum Posicion {
  PORTERO
  DEFENSA
  MEDIO
  DELANTERO
}

enum EstadoPartido {
  FUTURO
  EN_JUEGO
  FINALIZADO
  CANCELADO
}

model User {
  id       String  @id @default(cuid())
  name     String
  username String    @unique(map: "User_username_key")
  email    String    @unique(map: "User_email_key")
  image    String?
  password String
  active   Boolean   @default(true)
  createAt DateTime  @default(now())
  updateAt DateTime?
  telefono String?
  apellido String?
  role     Role @default(VISITANTE)

    equipos  Equipo[] 
}

model Temporada {
  id        String          @id @default(cuid())
  estado    EstadoTemporada @default(ACTIVA)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  partido Partido[]
}



model Equipo {
  id           String   @id @default(cuid())
  nombre       String
  escudo       String?
  localidad    String?
  entrenadorId String
  entrenador   User     @relation(fields: [entrenadorId], references: [id], onDelete: Cascade)


  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime?

  jugador Jugador[]

  partidosA Partido[] @relation("EquipoA")
  partidosB Partido[] @relation("EquipoB")


  TablaGeneral TablaGeneral[]
}





model Jugador {
  id         String    @id @default(cuid())
  nombre     String
  apellidos  String
  numero     Int
  posicion   Posicion
  posicionDetalle String?

  foto       String?

  equipo     Equipo    @relation(fields: [equipoId], references: [id], onDelete: Cascade)
  equipoId   String

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}


model Partido {
  id            String         @id @default(cuid())
  // esto serian los datos para crear un partido
  fechaHora     DateTime
  lugar         String
  //esepto el estado, iniciara como FUTURO 
  estado        EstadoPartido  @default(FUTURO)
  jornada       Int
 //lo que es la temporada, y los equipos, esos solo se les agregaria la id existente
  temporada     Temporada      @relation(fields: [temporadaId], references: [id])
  temporadaId   String

  equipoA       Equipo         @relation("EquipoA", fields: [equipoAId], references: [id])
  equipoAId     String

  equipoB       Equipo         @relation("EquipoB", fields: [equipoBId], references: [id])
  equipoBId     String

//los goles ya seria pura actualizacion 
  golesEquipoA  Int            @default(0)
  golesEquipoB  Int            @default(0)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}


model TablaGeneral {
  id         String   @id @default(cuid())
  num       Int       @default(0)
  equipoId   String
  PJ         Int      @default(0)
  PG         Int      @default(0)
  PE         Int      @default(0)
  PP         Int      @default(0)
  GF         Int      @default(0)
  GC         Int      @default(0)
  DIF        Int      @default(0)
  Pts        Int      @default(0)

  equipo     Equipo   @relation(fields: [equipoId], references: [id])

  updatedAt  DateTime @updatedAt
}